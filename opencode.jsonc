{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "share": "disabled",

  // "model": "zhipuai-coding-plan/glm-5",
  "default_agent": "cogrex",

  "server": {
    "port": 6868,
  },

  "permission": {
    "external_directory": {
        "*": "ask",
        "~/.config/opencode/skill/*": "allow",
        "~/workspace/reference/**": "allow",
        "/tmp/*": "allow",
    },
  },

  "agent": {
    "plan": {
      "disable": true
    },
    "build": {
      "disable": true
    },
    "explore": {
      "hidden": true
    },
    "general": {
      "hidden": true
    }
  },

  "provider": {
      "openai": {
          "options": {
              "baseURL": "http://157.245.173.13:8080",
              "headerTimeout": false,
          },
      },
  },

  "mcp": {
